# Config do Firebase (obrigatória). Copie este arquivo para `.env.local` e
# preencha com os valores do SEU projeto:
#   Firebase Console → Configurações do projeto → Seus apps → app Web → SDK.
# Os valores de config web não são segredo (vão pro bundle do cliente), mas
# ficam fora do repositório. `.env.local` é ignorado pelo git.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# App Check (opcional até você registrar). Site key do reCAPTCHA Enterprise:
#   Google Cloud → reCAPTCHA Enterprise → criar chave (Site, score-based) e
#   copiar o ID; registrar em Firebase Console → App Check (provedor Enterprise).
# Sem esta chave, o App Check é ignorado (o app funciona normalmente).
NEXT_PUBLIC_APPCHECK_SITE_KEY=
# Em dev/localhost defina como "true" para gerar um token de debug (aparece no
# console do navegador) e registrá-lo em App Check → Apps → Tokens de debug.
NEXT_PUBLIC_APPCHECK_DEBUG=
